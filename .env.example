OPENAI_API_KEY=
OPENAI_BASE_URL=                 # empty = official OpenAI
KITLY_MODEL_PLANNER=gpt-6-luna
KITLY_PLANNER_EFFORT=low         # never "none"
KITLY_MODEL_FAST=gpt-6-luna
KITLY_FAST_EFFORT=low
KITLY_SERVICE_TIER=               # "fast" = OpenAI Fast mode (≈1.5x faster, 2x price); empty = not sent (proxies)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=                 # Postgres connection string, only for npm run db:migrate / seed
KITLY_ADAPTER=supabase           # or memory
KITLY_DB_SCHEMA=public
DEMO_TODAY=2026-09-02            # D45; fallback 2026-08-20
NEXT_PUBLIC_KITLY_MOCK=0         # 1 = Kitly screen replays src/contract/fixtures/kit.sample.json
KITLY_PROPOSAL_SECRET=           # HMAC secret for enrichment proposal tokens (else SUPABASE_SERVICE_ROLE_KEY)
KITLY_BASIC_AUTH=                # optional user:pass to put the whole app behind HTTP Basic Auth
